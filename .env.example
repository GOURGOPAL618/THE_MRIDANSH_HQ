# ==============================================
# THE MRIDANSH HQ — Environment Configuration
# Jagannath Command Center (JCC)
# ==============================================
# Copy this file to .env and fill in real values.
# NEVER commit your actual .env file to Git.
# ==============================================

# ---------- Core Application ----------
ENVIRONMENT=development
DEBUG=true

# ---------- Database ----------
DATABASE_URL=sqlite:///./mridansh.db
# For production (PostgreSQL):
# DATABASE_URL=postgresql://user:password@host:5432/mridansh

# ---------- Authentication / Security ----------
JWT_SECRET_KEY=replace_with_secure_secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---------- Rate Limiting ----------
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_AI=10/minute
RATE_LIMIT_GENERAL=100/minute

# ---------- External API Integrations ----------
NASA_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENWEATHER_API_KEY=
GITHUB_API_KEY=
MAPS_API_KEY=

# ---------- Future Integration Stubs ----------
PIXXEL_API_KEY=
ESA_API_KEY=
ISRO_API_KEY=

# ---------- Frontend ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=THE MRIDANSH HQ

# ---------- Logging ----------
LOG_LEVEL=info
