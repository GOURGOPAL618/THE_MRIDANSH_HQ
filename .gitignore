# ---------- Environment & Secrets ----------
.env
.env.local
.env.*.local
*.pem
*.key

# ---------- Python / Backend ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
pip-log.txt

# ---------- Database ----------
*.db
*.sqlite3
mridansh.db
mridansh.db-shm
mridansh.db-wal

# ---------- Alembic ----------
backend/alembic/versions/__pycache__/

# ---------- Node / Frontend ----------
node_modules/
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo

# ---------- Next.js ----------
.next/
next-env.d.ts

# ---------- Testing ----------
coverage/
.nyc_output/
htmlcov/
.coverage

# ---------- Logs ----------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- OS Files ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Editor / IDE ----------
.vscode/
.idea/
*.swp
*.swo

# ---------- Docker ----------
*.pid

# ---------- Misc ----------
.cache/
tmp/
temp/
*.bak

# Node.js (Frontend)
node_modules/
.next/
out/
build/
dist/
.env*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# Environment files
.env
.env.*
!.env.example

# Python (Backend)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
*.db
*.log

# OS & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Local system logs & assets backups
logs/*.log
storage/*
!storage/.gitkeep
backups/*
!backups/.gitkeep
